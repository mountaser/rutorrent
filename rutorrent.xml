<?xml version="1.0"?>
<Container version="2">
  <Name>rutorrent</Name>
  <Repository>ghcr.io/mountaser/rutorrent:latest</Repository>
  <Registry>https://github.com/mountaser/rutorrent/pkgs/container/rutorrent</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mountaser/rutorrent/issues</Support>
  <Project>https://github.com/Novik/ruTorrent</Project>
  <ReadMe/>
  <Overview>Modern, high-performance rTorrent, ruTorrent &amp;amp; Flood container running on Alpine Linux + PHP 8.4 with zero VPN overhead.</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Novik/ruTorrent/master/favicon.ico</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Flood WebUI Port" Target="3000" Default="3000" Mode="tcp" Description="Flood Modern Web Interface" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="ruTorrent WebUI Port" Target="9080" Default="9080" Mode="tcp" Description="ruTorrent Web Interface" Type="Port" Display="always" Required="true" Mask="false">9080</Config>
  <Config Name="SCGI Port" Target="5000" Default="5000" Mode="tcp" Description="SCGI / RPC Port for Sonarr &amp;amp; Radarr" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="BitTorrent Incoming Port" Target="50000" Default="50000" Mode="tcp" Description="Single BitTorrent Incoming Listening Port" Type="Port" Display="always" Required="true" Mask="false">50000</Config>
  <Config Name="BitTorrent Incoming Port Variable" Target="RT_INC_PORT" Default="50000" Mode="" Description="rTorrent BitTorrent Incoming Port" Type="Variable" Display="always" Required="false" Mask="false">50000</Config>
  <Config Name="Enable Flood UI" Target="ENABLE_FLOOD" Default="yes" Mode="" Description="Enable Flood Modern UI (yes/no)" Type="Variable" Display="always" Required="false" Mask="false">yes</Config>
  <Config Name="Flood Port Variable" Target="FLOOD_PORT" Default="3000" Mode="" Description="Internal Flood Port" Type="Variable" Display="advanced-hide" Required="false" Mask="false">3000</Config>
  <Config Name="State Save Interval Variable" Target="RT_STATE_SAVE_SECONDS" Default="10" Mode="" Description="Interval in seconds to save live UI settings changes to disk" Type="Variable" Display="advanced-hide" Required="false" Mask="false">10</Config>
  <Config Name="Session Save Interval Variable" Target="RT_SESSION_SAVE_SECONDS" Default="1200" Mode="" Description="Interval in seconds to snapshot active session torrent state to disk" Type="Variable" Display="advanced-hide" Required="false" Mask="false">1200</Config>
  <Config Name="File Pre-allocation Mode" Target="RT_PREALLOCATE_TYPE" Default="0" Mode="" Description="0=Disabled (recommended), 1=Enabled (fallocate)" Type="Variable" Display="advanced" Required="false" Mask="false">0</Config>
  <Config Name="WebUI Username" Target="WEBUI_USER" Default="admin" Mode="" Description="ruTorrent WebUI Username" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="WebUI Password" Target="WEBUI_PASS" Default="admin" Mode="" Description="ruTorrent WebUI Password" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="RPC2 Username" Target="RPC2_USER" Default="admin" Mode="" Description="RPC2 Username for Sonarr/Radarr" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="RPC2 Password" Target="RPC2_PASS" Default="admin" Mode="" Description="RPC2 Password for Sonarr/Radarr" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="User ID" Target="PUID" Default="99" Mode="" Description="Unraid nobody user ID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="Group ID" Target="PGID" Default="100" Mode="" Description="Unraid users group ID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Description="Container Timezone" Type="Variable" Display="always" Required="false" Mask="false">UTC</Config>
  <Config Name="Umask" Target="UMASK" Default="000" Mode="" Description="File Creation Mask" Type="Variable" Display="always" Required="false" Mask="false">000</Config>
  <Config Name="Downloads Path" Target="/data" Default="/mnt/user/data" Mode="rw" Description="Media Downloads Path" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/data</Config>
  <Config Name="AppData Config Path" Target="/config" Default="/mnt/user/appdata/rutorrent" Mode="rw" Description="AppData Configuration Directory" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/rutorrent</Config>
  <TailscaleStateDir/>
</Container>
