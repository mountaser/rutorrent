<?xml version="1.0"?>
<Container version="2">
  <Name>binhex-rtorrentvpn</Name>
  <Repository>ghcr.io/mountaser/rutorrent:latest</Repository>
  <Registry>https://github.com/mountaser/rutorrent/pkgs/container/rutorrent</Registry>
  <Network>swag</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mountaser/rutorrent/issues</Support>
  <Project>https://github.com/Novik/ruTorrent</Project>
  <ReadMe/>
  <Overview>Modern, high-performance rTorrent, ruTorrent &amp;amp; Flood container running on Alpine Linux + PHP 8.4 with zero VPN overhead.</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Novik/ruTorrent/master/favicon.ico</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1786141052</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Flood WebUI Port" Target="3000" Default="3000" Mode="tcp" Description="Flood Modern Web Interface" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="ruTorrent WebUI Port" Target="9080" Default="9080" Mode="tcp" Description="ruTorrent Web Interface" Type="Port" Display="always" Required="true" Mask="false">9080</Config>
  <Config Name="SCGI Port" Target="5000" Default="5000" Mode="tcp" Description="SCGI / RPC Port for Sonarr &amp;amp; Radarr" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="Public Incoming Port" Target="51741" Default="51741" Mode="tcp" Description="BitTorrent Incoming Listening Port" Type="Port" Display="always" Required="false" Mask="false">51741</Config>
  <Config Name="Torrent Port Range" Target="50001-50100" Default="50001-50100" Mode="tcp" Description="BitTorrent Peer Port Range" Type="Port" Display="always" Required="false" Mask="false"/>
  <Config Name="Enable Flood UI" Target="ENABLE_FLOOD" Default="yes" Mode="" Description="Enable Flood Modern UI (yes/no)" Type="Variable" Display="always" Required="false" Mask="false">yes</Config>
  <Config Name="Flood Port Variable" Target="FLOOD_PORT" Default="3000" Mode="" Description="Internal Flood Port" Type="Variable" Display="advanced-hide" Required="false" Mask="false">3000</Config>
  <Config Name="WebUI Username" Target="WEBUI_USER" Default="admin" Mode="" Description="ruTorrent WebUI Username" Type="Variable" Display="always" Required="false" Mask="false">moun</Config>
  <Config Name="WebUI Password" Target="WEBUI_PASS" Default="" Mode="" Description="ruTorrent WebUI Password" Type="Variable" Display="always" Required="false" Mask="false">moun2641297</Config>
  <Config Name="RPC2 Username" Target="RPC2_USER" Default="admin" Mode="" Description="RPC2 Username for Sonarr/Radarr" Type="Variable" Display="always" Required="false" Mask="false">moun</Config>
  <Config Name="RPC2 Password" Target="RPC2_PASS" Default="" Mode="" Description="RPC2 Password for Sonarr/Radarr" Type="Variable" Display="always" Required="false" Mask="false">moun2641297</Config>
  <Config Name="User ID" Target="PUID" Default="99" Mode="" Description="Unraid nobody user ID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="Group ID" Target="PGID" Default="100" Mode="" Description="Unraid users group ID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Description="Container Timezone" Type="Variable" Display="always" Required="false" Mask="false">UTC</Config>
  <Config Name="Umask" Target="UMASK" Default="000" Mode="" Description="File Creation Mask" Type="Variable" Display="always" Required="false" Mask="false">000</Config>
  <Config Name="Downloads Path" Target="/data" Default="/mnt/user/data" Mode="rw" Description="Media Downloads Path" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/MounServer/</Config>
  <Config Name="AppData Config Path" Target="/config" Default="/mnt/user/appdata/binhex-rtorrentvpn" Mode="rw" Description="AppData Configuration Directory" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/binhex-rtorrentvpn</Config>
  <TailscaleStateDir/>
</Container>
